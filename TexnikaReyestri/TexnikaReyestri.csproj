<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TexnikaReyestri</RootNamespace>
    <AssemblyName>TexnikaReyestri</AssemblyName>
    <ApplicationIcon>Assets\TexnikaReyestri.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <AssemblyTitle>Texnika Reyestri</AssemblyTitle>
    <Product>Texnika Reyestri</Product>
    <Description>Təmir zavodları üzrə texnikanın qəbulu, təmiri və təhvilinin uçotu</Description>
    <!-- Linux/CI-da yalnız kompilyasiya yoxlaması üçün; Windows-da təsiri yoxdur -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Publish zamanı kod əvvəlcədən maşın koduna çevrilir: ilk açılış və hər səhifənin ilk açılışı sürətlənir (JIT gözləməsi olmur) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\TexnikaReyestri.ico" />
  </ItemGroup>
</Project>
